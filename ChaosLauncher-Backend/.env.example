# ==========================================
# CHAOS LAUNCHER BACKEND - CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=ChaosLauncher-API

# ==========================================
# POSTGRESQL DATABASE
# ==========================================
POSTGRES_USER=chaos_user
POSTGRES_PASSWORD=chaos_secret_pass
POSTGRES_DB=chaos_launcher_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL de conexión directa para Prisma
# Local (sin docker): postgresql://chaos_user:chaos_secret_pass@localhost:5432/chaos_launcher_db?schema=public
# Docker: postgresql://chaos_user:chaos_secret_pass@postgres:5432/chaos_launcher_db?schema=public
DATABASE_URL=postgresql://chaos_user:chaos_secret_pass@localhost:5432/chaos_launcher_db?schema=public

# ==========================================
# SUPERADMIN & JWT AUTH
# ==========================================
SUPERADMIN_USERNAME=admin
# Obligatorio (mín. 8 caracteres). Cámbialo.
SUPERADMIN_PASSWORD=CAMBIA_ESTA_PASSWORD
# Obligatorio (mín. 32 caracteres). Genera uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ==========================================
# CORS & GITHUB
# ==========================================
# Orígenes permitidos separados por coma (no uses * en producción)
CORS_ORIGIN=http://localhost:3001
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# ==========================================
# MINECRAFT STATUS CACHE & STORAGE
# ==========================================
STATUS_CACHE_TTL_SECONDS=30
UPLOAD_DIR=./uploads
STATIC_SERVE_PATH=/static

# API key gratuita de CurseForge (https://console.curseforge.com) para importar modpacks desde ZIP
CURSEFORGE_API_KEY=

# Cookie de sesión: "false" si sirves el sitio por HTTP (sin certificado); en HTTPS déjalo vacío o "true"
COOKIE_SECURE=
