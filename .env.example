# ==========================================================================
# CHAOS LAUNCHER - Variables del docker compose completo
# Copia este archivo a ".env" y rellena los valores marcados como OBLIGATORIO.
# El archivo ".env" NO se sube a Git.
# ==========================================================================

# ---------- Base de datos (OBLIGATORIO: contraseña) ----------
POSTGRES_USER=chaos_user
# Usa solo letras y números (se inserta en una URL). Genera una: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
POSTGRES_DB=chaos_launcher_db
POSTGRES_PORT=5432

# ---------- Superadmin y sesión (OBLIGATORIO) ----------
SUPERADMIN_USERNAME=admin
# Mínimo 8 caracteres. Es la contraseña con la que entras al Studio.
SUPERADMIN_PASSWORD=
# Mínimo 32 caracteres. Genera uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- Direcciones públicas ----------
# Puertos publicados en esta máquina
FRONT_PORT=3001
BACKEND_PORT=3000
# Cómo llegan los usuarios al backend (el launcher de escritorio y las imágenes subidas lo usan).
# En un servidor: http://IP_O_DOMINIO:3000  (o https://api.tudominio.com si usas proxy inverso)
BACKEND_PUBLIC_URL=http://localhost:3000
# Orígenes (separados por coma) desde los que el navegador puede llamar al API. Pon la URL pública del front.
CORS_ORIGIN=http://localhost:3001
# "false" si sirves el sitio por HTTP; "true" si usas HTTPS (la cookie de sesión exige HTTPS en producción)
COOKIE_SECURE=false

# ---------- Integraciones ----------
# Token de GitHub (permiso "repo") para el generador de manifiestos del backend. Opcional.
GITHUB_TOKEN=
# API key gratuita de CurseForge (https://console.curseforge.com) para importar modpacks desde ZIP
CURSEFORGE_API_KEY=

STATUS_CACHE_TTL_SECONDS=30

# ---------- Frontend (se incrustan al construir la imagen) ----------
# Déjalo en /api/v1: el navegador llama al propio front y este reenvía al backend interno.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME=ChaosLauncher Web Studio
NEXT_PUBLIC_DEFAULT_SERVER_IP=
NEXT_PUBLIC_LAUNCHER_REPO=LuisEnriqueGM03/Chaos-Launcher-Esc
NEXT_PUBLIC_WINGET_PACKAGE_ID=ChaosStudio.ChaosLauncher
# Pon true cuando el paquete esté aprobado en winget-pkgs
NEXT_PUBLIC_WINGET_LIVE=false

# ---------- Imágenes y auto-actualización (Watchtower) ----------
# Dueño de las imágenes en GHCR (en minúsculas) y etiqueta a ejecutar
GHCR_OWNER=luisenriquegm03
IMAGE_TAG=latest
# Cada cuántos segundos Watchtower busca imágenes nuevas
WATCHTOWER_POLL_INTERVAL=60
# Solo si las imágenes de GHCR son PRIVADAS: tu usuario de GitHub y un token (classic) con permiso read:packages
GHCR_USER=
GHCR_TOKEN=
TZ=America/La_Paz
